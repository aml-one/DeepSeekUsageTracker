<Window x:Class="DeepSeekUsageTracker.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Width="340"
        Height="240"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Border CornerRadius="10"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="25"
                              ShadowDepth="0"
                              Opacity="0.7"
                              Color="#000000" />
        </Border.Effect>

        <Grid Margin="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0"
                    CornerRadius="10 10 0 0"
                    Background="#0f3460"
                    Opacity="0.4" />
            <TextBlock Grid.Row="0"
                       Text="Settings"
                       Foreground="{StaticResource TextPrimary}"
                       FontSize="12"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />

            <!-- Content -->
            <StackPanel Grid.Row="1"
                        Margin="14,14">
                <TextBlock Text="API Key"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,0,0,4" />

                <PasswordBox x:Name="ApiKeyBox"
                             Background="{StaticResource SurfaceBrush}"
                             Foreground="{StaticResource TextPrimary}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             FontSize="13"
                             Padding="8,6"
                             PasswordChar="•" />

                <TextBlock x:Name="HintText"
                           Text="Paste your key from platform.deepseek.com/api_keys"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="9"
                           Margin="0,6,0,0"
                           TextWrapping="Wrap" />

                <!-- Refresh interval -->
                <TextBlock Text="Refresh interval"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="11"
                           Margin="0,12,0,4" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left">
                    <RadioButton x:Name="Rb1m"
                                 Content="1m"
                                 GroupName="Interval"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="12"
                                 Margin="0,0,8,0"
                                 Checked="Interval_Checked" />
                    <RadioButton x:Name="Rb5m"
                                 Content="5m"
                                 GroupName="Interval"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="12"
                                 Margin="0,0,8,0"
                                 Checked="Interval_Checked" />
                    <RadioButton x:Name="Rb10m"
                                 Content="10m"
                                 GroupName="Interval"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="12"
                                 Margin="0,0,8,0"
                                 Checked="Interval_Checked" />
                    <RadioButton x:Name="Rb30m"
                                 Content="30m"
                                 GroupName="Interval"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="12"
                                 Margin="0,0,8,0"
                                 Checked="Interval_Checked" />
                    <RadioButton x:Name="Rb60m"
                                 Content="60m"
                                 GroupName="Interval"
                                 Foreground="{StaticResource TextPrimary}"
                                 FontSize="12"
                                 Margin="0,0,0,0"
                                 Checked="Interval_Checked" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,14,0,0">
                    <Button Content="Cancel"
                            Width="70"
                            Height="28"
                            Style="{StaticResource DarkButton}"
                            Click="CancelBtn_Click" />
                    <Button Content="Save"
                            Width="70"
                            Height="28"
                            Style="{StaticResource AccentButton}"
                            Margin="8,0,0,0"
                            Click="SaveBtn_Click" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
