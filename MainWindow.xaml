<Window x:Class="DeepSeekUsageTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepSeekUsageTracker"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        Topmost="True"
        Width="240"
        Height="140"
        Opacity="0.92"
        Background="Transparent"
        MouseDown="Window_MouseDown"
        Loaded="Window_Loaded">

    <Grid>
        <!-- Outer border -->
        <Border CornerRadius="12"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
            <Border.Background>
                <RadialGradientBrush GradientOrigin="0.15,0.15" Center="0.15,0.15"
                                     RadiusX="1.2" RadiusY="1.2">
                    <GradientStop Color="#2a2a50" Offset="0"/>
                    <GradientStop Color="#1a1a2e" Offset="0.5"/>
                    <GradientStop Color="#0f0f22" Offset="1"/>
                </RadialGradientBrush>
            </Border.Background>
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="0"
                                  Opacity="0.6"
                                  Color="#000000" />
            </Border.Effect>

            <Grid Margin="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>

                <!-- Branding -->
                <TextBlock Text="Made by AmL"
                           Foreground="{StaticResource TextSecondary}"
                           FontSize="5"
                           VerticalAlignment="Top"
                           HorizontalAlignment="Center"
                           Margin="-35,15,0,0" />

                <!-- Content -->
                <StackPanel Grid.Row="0"
                            VerticalAlignment="Center"
                            Margin="0,0">
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <Image Source="/Images/deepseek_yellow.png"
                               Width="25"
                               Height="25"
                               Margin="0,-6,3,0"
                               VerticalAlignment="Center" />
                        <!-- Title -->
                        <TextBlock Text="DeepSeek API"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,8" />
                    </StackPanel>

                    <!-- ═══════ BALANCE MODE ═══════ -->
                    <Border x:Name="BalancePanel"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="10"
                            HorizontalAlignment="Center"
                            MinWidth="200"
                            Cursor="Hand"
                            ToolTip="Double-click to refresh">
                        <Grid HorizontalAlignment="Center"
                              Margin="0,0,-13,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BalanceText"
                                       Text="--.--"
                                       Grid.Column="0"
                                       Foreground="{StaticResource YellowBrush}"
                                       FontSize="32"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       Margin="0,-5,0,0" />
                            <TextBlock x:Name="CurrencyText"
                                       Text="---"
                                       Grid.Column="1"
                                       Foreground="{StaticResource YellowBrush}"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="4,0,0,0" />
                            <TextBlock Text="Balance left"
                                       Grid.ColumnSpan="2"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="11"
                                       Margin="0,0,0,-7"
                                       VerticalAlignment="Bottom"
                                       HorizontalAlignment="Center" />
                        </Grid>
                    </Border>

                    <!-- ═══════ PERCENTAGE MODE ═══════ -->
                    <Border x:Name="PercentPanel"
                            Background="{StaticResource SurfaceBrush}"
                            CornerRadius="8"
                            Padding="12,10"
                            HorizontalAlignment="Center"
                            MinWidth="200"
                            Cursor="Hand"
                            ToolTip="Double-click to refresh"
                            Visibility="Collapsed">
                        <Grid>
                            <TextBlock Text="Usage"
                                       Foreground="{StaticResource TextSecondary}"
                                       FontSize="10"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Margin="0,0,0,0" />
                            <StackPanel>
                                <TextBlock x:Name="PercentText"
                                           Text="--%"
                                           Foreground="{StaticResource YellowBrush}"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Margin="0,-14,0,2" />
                                <!-- 4px tall progress bar -->
                                <Border CornerRadius="2"
                                        Height="4"
                                        Background="#1a2a3e"
                                        HorizontalAlignment="Stretch">
                                    <Border x:Name="ProgressFill"
                                            CornerRadius="2"
                                            Background="{StaticResource YellowBrush}"
                                            Width="0"
                                            HorizontalAlignment="Left" />
                                </Border>
                                <TextBlock x:Name="PercentDetail"
                                           Text=""
                                           Foreground="{StaticResource TextSecondary}"
                                           FontSize="9"
                                           HorizontalAlignment="Center"
                                           Margin="0,4,0,-8" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom bar: status + countdown | settings -->
                <Grid Grid.Row="1"
                      Margin="12,0,12,6">
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Left">
                        <!-- Status dot -->
                        <Ellipse x:Name="StatusDot"
                                 Width="5"
                                 Height="5"
                                 Fill="{StaticResource TextSecondary}"
                                 Margin="0,0,5,0"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusLabel"
                                   Text="No API key set"
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="9"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusDot2"
                                   Text=""
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="9"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusCountdown"
                                   Text=""
                                   Foreground="{StaticResource TextSecondary}"
                                   FontSize="9"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Settings gear button -->
                    <Button x:Name="SettingsBtn"
                            Width="24"
                            Height="24"
                            BorderThickness="0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Cursor="Hand"
                            Click="SettingsBtn_Click"
                            ToolTip="Settings">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd"
                                        CornerRadius="4"
                                        Background="Transparent">
                                    <TextBlock Text="⚙"
                                               FontSize="14"
                                               Foreground="{StaticResource TextSecondary}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="#20eaeaea" />
                                    </Trigger>
                                    <Trigger Property="IsPressed"
                                             Value="True">
                                        <Setter TargetName="Bd"
                                                Property="Background"
                                                Value="#15eaeaea" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
